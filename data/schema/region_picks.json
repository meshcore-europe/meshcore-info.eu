{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "data/region_picks.yaml: the regions the province picker offers for a country",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "country", "regions", "source", "last_checked"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
      "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
      "regions": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } },
      "source": { "type": "string", "pattern": "^https://" },
      "last_checked": { "type": "string", "format": "date" }
    },
    "additionalProperties": false
  }
}
