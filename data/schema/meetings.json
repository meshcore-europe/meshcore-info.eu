{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "data/meetings.yaml: meetings of local groups and others",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "country", "name", "join", "languages", "date", "time", "timezone", "last_checked"],
    "oneOf": [
      { "required": ["group"] },
      { "required": ["listed_by"] },
      { "required": ["who", "link"] }
    ],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
      "group": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
      "listed_by": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
      "who": { "type": "string", "minLength": 1 },
      "link": { "type": "string", "pattern": "^https://" },
      "country": { "type": "string", "pattern": "^[A-Za-z]{2}$" },
      "name": { "type": "string", "minLength": 1 },
      "join": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["kind"],
          "if": { "properties": { "kind": { "const": "online" } } },
          "then": { "required": ["url"] },
          "else": { "required": ["place"] },
          "properties": {
            "kind": { "enum": ["in_person", "online", "channel"] },
            "place": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "pattern": "^https://" },
            "location": {
              "type": "object",
              "required": ["lat", "lon"],
              "properties": { "lat": { "type": "number", "minimum": -90, "maximum": 90 }, "lon": { "type": "number", "minimum": -180, "maximum": 180 } },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "languages": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z]{2,3}$" }, "uniqueItems": true },
      "date": { "type": "string", "format": "date" },
      "time": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
      "timezone": { "type": "string", "pattern": "^(Europe|Atlantic)/[A-Za-z_]+$" },
      "repeat": { "enum": ["weekly", "monthly"] },
      "last_checked": { "type": "string", "format": "date" }
    },
    "additionalProperties": false
  }
}
