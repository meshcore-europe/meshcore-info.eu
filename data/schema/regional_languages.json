{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "data/regional_languages.yaml: languages offered by the visitor's area",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "areas"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z]{2}$" },
      "areas": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["country"],
          "properties": {
            "country": { "type": "string", "pattern": "^[A-Z]{2}$" },
            "region": { "type": "string", "pattern": "^[A-Z0-9]{1,3}$" }
          },
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false
  }
}
