---
// The table of a country's own regions on /guides/settings/, once per country, under its areas. Which regions it
// lists comes from data/region_baselines.yaml.
import { t } from '../lib/site.mjs';

const { lang, baseline } = Astro.props;
const r = (k) => t(lang, `regions_${k}`);
const dateOf = (iso) => new Intl.DateTimeFormat(lang === 'en' ? 'en-GB' : lang, { dateStyle: 'long' }).format(new Date(`${iso}T00:00:00Z`));
---
<section class="region-baseline" id={`regions-${baseline.country.toLowerCase()}`}>
  <h3>{r('table_title')}</h3>
  <div class="table-wrap" tabindex="0" role="region" aria-label={r('table_title')}>
    <table>
      <thead><tr><th scope="col">{r('table_region')}</th><th scope="col">{r('table_inside')}</th></tr></thead>
      <tbody>{baseline.regions.map((x) => (
        <tr><th scope="row">{x.name} <code>{x.code}</code></th><td>{x.inside.map((d, i) => <Fragment>{i > 0 && ', '}{d.name} <code>{d.code}</code></Fragment>)}</td></tr>
      ))}</tbody>
    </table>
  </div>
  {baseline.footnote_key && <p>{t(lang, baseline.footnote_key)}</p>}
  <p class="meta">{`${t(lang, 'area_source_group')} `}<a href={baseline.source}>{baseline.group}</a>, {t(lang, 'area_checked')} <time datetime={baseline.last_checked}>{dateOf(baseline.last_checked)}</time></p>
</section>
