---
// A language picker for a path without a language: / or a page such as /press-kit/. web/js/picker.js sends
// the visitor to the page in the best matching language; the list of links is the fallback without JavaScript.
// Props: path (the page's slug, '' for the home), langs (the languages the page exists in), title and description
// (for the card an app shows for a short link: it reads this page and runs no script).
import { existsSync } from 'node:fs';
import { BASE_URL, LANGUAGES, ROOT, t } from '../lib/site.mjs';

const { path = '', langs, title = 'meshcore-info.eu', description = t('en', 'site_description') } = Astro.props;
const cardName = path ? path.replace(/\//g, '-') : 'home';
const card = new URL(`/media/og/${existsSync(`${ROOT}web/media/og/${cardName}.jpg`) ? cardName : 'home'}.jpg`, BASE_URL).href;
const shown = LANGUAGES.filter((l) => langs.includes(l.key));
const suffix = path ? `${path}/` : '';
---
<!doctype html>
<html lang="en" data-langs={shown.map((l) => l.key).join(' ')} data-path={suffix} data-theme="industrial">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="robots" content="noindex">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="meshcore-info.eu">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={card}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content={card}>
  <meta name="color-scheme" content="light dark">
  <script is:inline src="/js/picker.js"></script>
  <script is:inline src="/shell/prefs.js"></script>
  <link rel="stylesheet" href="/shell/fonts.css">
  <link rel="stylesheet" href="/shell/tokens.css">
  <link rel="stylesheet" href="/shell/base.css">
  <link rel="stylesheet" href="/shell/shell.css">
  <link rel="stylesheet" href="/css/site.css">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
</head>
<body class="picker">
  <main class="page container">
    <p class="brand-mark">meshcore-info<span class="tld">.eu</span></p>
    <h1>{t('en', 'picker_title')}</h1>
    <ul class="lang-grid">
      {shown.map((l) => <li><a href={`/${l.key}/${suffix}`} lang={l.locale} hreflang={l.locale}>{l.label}</a></li>)}
    </ul>
  </main>
</body>
</html>
