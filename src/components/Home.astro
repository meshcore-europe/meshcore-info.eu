---
// The home.
// A film behind the floating glass header, the live strip at its foot, what the local groups share (HomeNear),
// the street and the ways in. The live strip fills from meshcore-analyzer.eu (web/js/live-strip.js)
// and stays hidden without JavaScript or when the analyzer does not answer. The film is added by web/js/hero-film.js
// (by mode, codec and screen width); without it the hero shows the poster of the mode. Coming back to the home
// from another page in the same visit, web/js/home-skip.js opens it at #content-start, under the film.
import { t, loadData } from '../lib/site.mjs';
import HomeTown from './HomeTown.astro';
import HomeNear from './HomeNear.astro';
const { lang, news, localize } = Astro.props;
const home = loadData('home');
---
<section class="xhero" aria-labelledby="home-title">
  <video class="xhero-video" data-hero-film muted loop playsinline preload="none" aria-hidden="true"></video>
  <div class="xhero-inner">
    <p class="eyebrow">{t(lang, 'hero_eyebrow')}</p>
    <h1 id="home-title">{t(lang, 'hero_title')}</h1>
    <p class="lead">{t(lang, 'hero_lead')}</p>
    <div class="row hero-actions">
      <a class="btn btn-primary" href={localize('/get-started/')}>{t(lang, 'hero_cta_start')}</a>
      <a class="btn" href={localize('/about/')}>{t(lang, 'hero_cta_about')}</a>
    </div>
  </div>
  <div class="credits" data-live-strip hidden>
    <div class="credits-inner">
      <div class="grp live"><span class="live-dot" aria-hidden="true"></span><span class="lbl">{t(lang, 'home_live_label')}</span>
        <span class="sentence"><span class="item"><span class="n" data-live="packets"></span> {t(lang, 'home_live_packets')}</span><span class="sep" aria-hidden="true"> · </span><span class="item"><span class="n" data-live="countries"></span> {t(lang, 'home_live_countries')}</span><span class="sep" aria-hidden="true"> · </span><span class="item"><span class="n" data-live="repeaters"></span> {t(lang, 'home_live_repeaters')}</span></span></div>
      <div class="grp"><a class="wm mono" href="https://meshcore-analyzer.eu/">{t(lang, 'home_live_source')}</a></div>
    </div>
  </div>
</section>

<div class="container home-body" id="content-start">
  <script is:inline src="/js/home-skip.js"></script>
  <HomeNear lang={lang} news={news} localize={localize} />

  <HomeTown lang={lang} localize={localize} />

  <section class="section" aria-labelledby="paths-title">
    <div class="section-head"><h2 id="paths-title">{t(lang, 'paths_title')}</h2></div>
    <ul class="paths">
      {home.paths.map((p) => (
        <li><a class="card path-card" href={localize(p.path)}><h3>{t(lang, `path_${p.id}_title`)}</h3><p>{t(lang, `path_${p.id}_desc`)}</p></a></li>
      ))}
    </ul>
  </section>
</div>
