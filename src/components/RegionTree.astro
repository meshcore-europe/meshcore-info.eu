---
// The Regions block of one area on /guides/settings/: the regions a repeater there sits in, as boxes
// inside each other (Europe, a group of countries such as Benelux, the country, a province or region, and a
// town where the area uses one), each linking to that region on the MeshCore Analyzer's map. Which regions exist
// comes from the catalog (data/regions.json, tools/update_regions.py), the groups of countries from
// data/region_groups.yaml. The commands are nested, each region under its parent. An area whose group already
// gives region commands (data/areas.yaml) shows the tree only: picking a province fills those commands in. A
// country whose community decided its own regions (data/region_baselines.yaml) takes its root and regions from there.
// web/js/regions.js runs the province picker.
import { t, loadData } from '../lib/site.mjs';
import CommandLine from './CommandLine.astro';
import catalog from '../../data/regions.json';

const { lang, area } = Astro.props;
const cc = area.country.toLowerCase();
const country = catalog.countries[cc];
const group = loadData('region_groups').find((g) => g.countries.includes(area.country));
const baseline = loadData('region_baselines').find((b) => b.country === area.country);
const root = baseline ? baseline.root : catalog.europe;
const MAP = 'https://meshcore-analyzer.eu/#regions';
const at = (code) => `${MAP}?region=${code}`;
const r = (k) => t(lang, `regions_${k}`);
// The area's own region commands, if its group gives them; otherwise the tree's own commands.
const own = (area.changes || []).some((c) => (c.commands || []).some((l) => l.startsWith('region put')));
const chain = [root, ...(group ? [group.code] : []), cc];
const presetRegions = baseline ? baseline.preset_regions || [] : [];
// The same nested tree, written 2 ways. The town shows once it is typed in its box (web/js/regions.js).
const TOWN = 'region put YOUR_CITY YOUR_PROVINCE';
const putLines = [`region put ${chain[0]}`, ...chain.slice(1).map((code, i) => `region put ${code} ${chain[i]}`),
  ...(presetRegions.length ? [`region put YOUR_BAND ${cc}`] : []), `region put YOUR_PROVINCE ${cc}`, TOWN, 'region save'];
const defLine = `region def ${chain.join(' ')}${presetRegions.length ? ` YOUR_BAND|${cc}` : ''} YOUR_PROVINCE`;
const regions = baseline ? baseline.regions : country ? country.regions : [];
---
<div class="regions" data-regions data-map={MAP}>
  <h4>{r('title')}</h4>
  <p>{r('body')}</p>
  {baseline && <p>{t(lang, baseline.note_key)}</p>}
  <div class="rbox r0">
    <div class="rhd"><b>{r('europe')}</b> <code>{root}</code><a href={MAP}>{r('map')}<span class="vh"> {r('map_label')}</span></a></div>
    {(() => {
      const inner = (
        <div class="rbox r2">
          <div class="rhd"><b>{t(lang, `country_${cc}`)}</b> <code>{cc}</code><a href={at(cc)}>{r('map')}<span class="vh"> {r('map_label')}</span></a></div>
          {presetRegions.length > 0 && (
            <div class="rbox r3">
              <div class="rhd">
                <select data-band-pick aria-label={r('preset_pick')}>
                  <option value="">{r('preset_pick')}</option>
                  {presetRegions.map((x) => <option value={x.code}>{x.name} ({x.code})</option>)}
                </select>
              </div>
            </div>
          )}
          {regions.length ? (
            <div class="rbox r3">
              <div class="rhd">
                <select data-region-pick aria-label={r('pick')}>
                  <option value="">{r('pick')}</option>
                  {regions.map((x) => <option value={x.code}>{x.name} ({x.code})</option>)}
                </select>
                <a href={at(cc)} data-region-link>{r('map')}<span class="vh"> {r('map_label')}</span></a>
              </div>
              <div class="rbox r4"><div class="rhd"><input type="text" data-region-town placeholder={baseline ? r('district') : r('town')} aria-label={baseline ? r('district') : r('town')} autocomplete="off" spellcheck="false" /><a href={at(cc)} data-region-link>{r('map')}<span class="vh"> {r('map_label')}</span></a></div></div>
            </div>
          ) : (
            <div class="rbox r4"><div class="rhd"><span>{r('region')}</span><a href={at(cc)}>{r('map')}<span class="vh"> {r('map_label')}</span></a></div></div>
          )}
        </div>
      );
      return group ? (
        <div class="rbox r1">
          <div class="rhd"><b>{group.name}</b> <code>{group.code}</code><a href={at(group.code)}>{r('map')}<span class="vh"> {r('map_label')}</span></a></div>
          {inner}
        </div>
      ) : inner;
    })()}
  </div>
  <p class="meta">{r('map_body')}</p>
  <p>{r('nesting')} <a href={`/${lang}/guides/resilient/#gate`}>{r('nesting_link')}</a></p>
  {!own && regions.length > 0 && (
    <Fragment>
      <p class="ph-hint">{r('cmd_hint')}</p>
      <fieldset class="cmd-style" data-cmd-style hidden>
        <legend>{r('style')}</legend>
        <label><input type="radio" name={`cmd-style-${area.id}`} value="put" checked /> {r('style_put')}</label>
        <label><input type="radio" name={`cmd-style-${area.id}`} value="def" /> {r('style_def')}</label>
      </fieldset>
      <div data-cmd="put">
        <pre>{putLines.map((line, i) => {
          return line === TOWN ? <span data-town-line hidden>{'\n'}<CommandLine lang={lang} line={line} /></span> : <Fragment>{i > 0 && '\n'}<CommandLine lang={lang} line={line} /></Fragment>;
        })}</pre>
      </div>
      <div data-cmd="def" hidden>
        <pre><CommandLine lang={lang} line={defLine} /><span data-town-line hidden> <CommandLine lang={lang} line="YOUR_CITY" /></span>{'\nregion save'}</pre>
      </div>
    </Fragment>
  )}
</div>
