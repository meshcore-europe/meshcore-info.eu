---
// The Regions block of one area, or of a country without an area, on /guides/settings/: the regions a repeater
// there sits in, as boxes inside each other (RegionBox.astro), each linking to that region on the MeshCore
// Analyzer's map. An area whose local group gives region commands (`region put` lines in data/areas.yaml) shows
// those as its tree, with one tree per root: the group's own tree, with the province picker where it puts
// YOUR_PROVINCE and the town where it puts YOUR_CITY. Every other area, and every country without one, shows the
// general chain: Europe, a group of countries (data/region_groups.yaml), the country, the province picker, the town,
// with the commands written 2 ways. A country whose community decided its own regions (data/region_baselines.yaml)
// takes its root and regions from there. Which provinces exist comes from the catalog (data/regions.json,
// tools/update_regions.py), narrowed by data/region_picks.yaml where the catalog lists more than the provinces.
// Names: Europe by its string, a group of countries by its name, a country by its string, a region from the catalog
// by its name; any other code shows as the code alone. web/js/regions.js runs the pickers and the town field.
import { t, hasString, loadData } from '../lib/site.mjs';
import { regionPuts, treesFrom, generalTree, generalPuts, generalDef } from '../lib/region-tree.mjs';
import CommandLine from './CommandLine.astro';
import RegionBox from './RegionBox.astro';
import catalog from '../../data/regions.json';

const { lang, area } = Astro.props;
const cc = area.country.toLowerCase();
const country = catalog.countries[cc];
const groups = loadData('region_groups');
const group = groups.find((g) => g.countries.includes(area.country));
const baseline = loadData('region_baselines').find((b) => b.country === area.country);
const picks = loadData('region_picks').find((p) => p.country === area.country);
const root = baseline ? baseline.root : catalog.europe;
const MAP = 'https://meshcore-analyzer.eu/#regions';
const r = (k) => t(lang, `regions_${k}`);
const puts = regionPuts(area.changes);
// The area's own region commands, if its group gives them; otherwise the general chain and its commands.
const own = puts.length > 0;
const bands = baseline ? baseline.preset_regions || [] : [];
const all = baseline ? baseline.regions : country ? country.regions : [];
const regions = picks ? all.filter((x) => picks.regions.includes(x.code)) : all;
const general = { root, group: group ? group.code : null, cc, bands: bands.length > 0, regions: regions.length > 0 };
const trees = own ? treesFrom(puts) : generalTree(general);
const catalogNames = new Map(Object.values(catalog.countries).flatMap((c) => c.regions.map((x) => [x.code, x.name])));
if (baseline) baseline.regions.forEach((x) => { catalogNames.set(x.code, x.name); x.inside.forEach((d) => catalogNames.set(d.code, d.name)); });
const name = (code) => {
  if (code === 'eu' || code === 'europe') return r('europe');
  const g = groups.find((x) => x.code === code);
  if (g) return g.name;
  if (/^[a-z]{2}$/.test(code) && hasString(`country_${code}`)) return t(lang, `country_${code}`);
  return catalogNames.get(code) || '';
};
const ctx = { cc, map: MAP, name, regions, bands, baseline: !!baseline };
const putLines = generalPuts(general);
const defLine = generalDef(general);
const isTown = (line) => line.startsWith('region put YOUR_CITY ');
---
<div class="regions" data-regions data-map={MAP}>
  <h4>{r('title')}</h4>
  <p>{r('body')}</p>
  {baseline && <p>{t(lang, baseline.note_key)}</p>}
  {trees.map((node) => <RegionBox lang={lang} node={node} ctx={ctx} />)}
  <p class="meta">{r('map_body')}</p>
  <p>{r('nesting')} <a href={`/${lang}/guides/resilient/#gate`}>{r('nesting_link')}</a></p>
  {!own && (
    <Fragment>
      <p class="ph-hint">{r(regions.length ? 'cmd_hint' : 'cmd_hint_town')}</p>
      <fieldset class="cmd-style" data-cmd-style hidden>
        <legend>{r('style')}</legend>
        <label><input type="radio" name={`cmd-style-${area.id}`} value="put" checked /> {r('style_put')}</label>
        <label><input type="radio" name={`cmd-style-${area.id}`} value="def" /> {r('style_def')}</label>
      </fieldset>
      <div data-cmd="put">
        <pre>{putLines.map((line, i) => {
          return isTown(line) ? <span data-town-line hidden>{'\n'}<CommandLine lang={lang} line={line} /></span> : <Fragment>{i > 0 && '\n'}<CommandLine lang={lang} line={line} /></Fragment>;
        })}</pre>
      </div>
      <div data-cmd="def" hidden>
        <pre><CommandLine lang={lang} line={defLine} /><span data-town-line hidden> <CommandLine lang={lang} line="YOUR_CITY" /></span>{'\nregion save'}</pre>
      </div>
    </Fragment>
  )}
</div>
